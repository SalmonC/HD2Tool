{
  "name": "hd2-supply-book",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "HD2 Supply Book: offline equipment lookup and unlock planning.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "validate:data": "node scripts/validate-data.mjs",
    "images:check": "node scripts/check-wiki-images.mjs",
    "images:accept": "node scripts/check-wiki-images.mjs --accept",
    "updates:check": "node scripts/check-update-anchors.mjs",
    "smoke": "node scripts/smoke.mjs",
    "size:check": "node scripts/size-budget.mjs",
    "desktop:check": "node scripts/check-neutralino.mjs",
    "desktop:build": "npm run build && node scripts/check-neutralino.mjs --require-binaries && npx --no-install neu build --embed-resources",
    "check": "npm run validate:data && npm test && npm run format:check && npm run build && npm run size:check && npm run smoke && npm run desktop:check"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.7.2",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
