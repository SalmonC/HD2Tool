{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hd2-supply-book.invalid/schema/v3/corrections.schema.json",
  "title": "v3 typed corrections with source bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "correctionsHash", "corrections"],
  "properties": {
    "schemaVersion": { "const": "corrections.v3" },
    "correctionsHash": { "$ref": "#/$defs/hash" },
    "corrections": {
      "type": "array",
      "items": { "$ref": "#/$defs/correction" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sha256"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "revision": { "type": "string" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctionId",
        "kind",
        "target",
        "expectedBefore",
        "sourceBindings",
        "evidenceFactIds",
        "reason",
        "reviewer",
        "reviewedAt",
        "after"
      ],
      "properties": {
        "correctionId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "identity-link",
            "candidate-selection",
            "fact-supersession",
            "taxonomy-map"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId"],
          "properties": {
            "entityId": { "type": "string" },
            "fieldPath": { "type": "string" }
          }
        },
        "expectedBefore": {},
        "sourceBindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceBinding" }
        },
        "evidenceFactIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "reason": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "expiry": { "type": "string", "format": "date-time" },
        "after": {}
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "identity-link" } } },
          "then": {
            "properties": {
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": ["equipmentId"],
                "properties": {
                  "equipmentId": { "type": "string" },
                  "externalKeys": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "candidate-selection" } }
          },
          "then": {
            "properties": {
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidateId"],
                "properties": { "candidateId": { "type": "string" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "fact-supersession" } } },
          "then": {
            "properties": {
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": ["replacementFactIds", "supersededFactIds"],
                "properties": {
                  "replacementFactIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                  },
                  "supersededFactIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "taxonomy-map" } } },
          "then": {
            "properties": {
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": ["taxonomy", "value"],
                "properties": {
                  "taxonomy": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
