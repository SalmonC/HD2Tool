{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hd2-supply-book.invalid/schema/v3/source-ledger.schema.json",
  "title": "v3 sealed snapshots and build-time raw ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputManifestHash", "snapshots", "facts", "candidates"],
  "properties": {
    "schemaVersion": { "const": "raw-ledger.v3" },
    "inputManifestHash": { "$ref": "#/$defs/hash" },
    "snapshots": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "pageId": { "type": "string" },
        "revision": { "type": "string" },
        "gameBuild": { "type": "string" },
        "locale": { "enum": ["en", "zh-Hans", "zh-Hant", "und"] },
        "jsonPath": { "type": "string" },
        "key": { "type": "string" },
        "fragment": { "type": "string" },
        "excerpt": { "type": "string" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "authority", "locator", "capturedAt", "sha256", "contentType"],
      "properties": {
        "sourceId": { "type": "string" },
        "kind": { "enum": ["wiki", "official-localization", "official-web", "community", "user", "local-file"] },
        "authority": { "enum": ["official", "wiki", "community", "user"] },
        "locator": { "$ref": "#/$defs/locator" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/hash" },
        "contentType": { "enum": ["wikitext", "json", "html", "strings", "image", "text"] },
        "extractor": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "subject", "fieldPath", "value", "sourceId", "locator", "extractorId", "extractorVersion"],
      "properties": {
        "factId": { "type": "string" },
        "subject": { "type": "string" },
        "fieldPath": { "type": "string" },
        "value": {},
        "unit": { "type": "string" },
        "sourceId": { "type": "string" },
        "locator": { "$ref": "#/$defs/locator" },
        "extractorId": { "type": "string" },
        "extractorVersion": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "subjectHint", "type", "sourceId", "factIds", "disposition"],
      "properties": {
        "candidateId": { "type": "string" },
        "subjectHint": { "type": "string" },
        "type": { "enum": ["identity", "name", "alias", "localization", "item-link", "item-cost", "page-prerequisite", "attack-component", "image", "acquisition", "classification"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "factIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "disposition": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "extracted" } } },
            { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "const": "rejected" }, "reason": { "enum": ["wrong-scope", "duplicate", "invalid", "rights-blocked"] } } },
            { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "const": "unresolved" }, "reason": { "enum": ["source-missing", "not-published", "parse-failed", "identity-unresolved", "ambiguous", "unknown-threshold", "rights-unresolved"] } } }
          ]
        }
      }
    }
  }
}
