{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hd2-supply-book.invalid/schema/v3/plan.schema.json",
  "title": "v3 bounded local purchase plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "catalogHash",
    "pendingIds",
    "completedIds",
    "orphans",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "plan.v3" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "catalogHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "pendingIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "completedIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "orphans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["equipmentId", "lastKnownName", "reason"],
        "properties": {
          "equipmentId": { "type": "string", "minLength": 1 },
          "lastKnownName": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["removed", "id-migration", "invalid"] }
        }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
