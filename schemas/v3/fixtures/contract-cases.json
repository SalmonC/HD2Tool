{
  "$schema": "https://hd2-supply-book.invalid/schema/v3/contract-cases.json",
  "schemaVersion": "contract-cases.v3",
  "syntheticOnly": true,
  "cases": [
    {
      "caseId": "mg43-exo55-product-kind",
      "inputs": {
        "mg": {
          "productKind": "support-weapon",
          "capabilityGroup": "combat",
          "deploymentGroup": "deployment"
        },
        "exo": {
          "productKind": "other-stratagem",
          "capabilityGroup": "combat",
          "deployment": { "kind": "vehicle" }
        }
      },
      "expected": {
        "mgUiGroup": "stratagem",
        "exoUiGroup": "stratagem",
        "mgCapabilityGroup": "combat",
        "exoDeploymentKind": "vehicle"
      }
    },
    {
      "caseId": "warbond-registry-and-asof",
      "inputs": {
        "catalogVersion": "fixture-catalog-1",
        "acquisitionAsOf": "2026-08-09T00:00:00.000Z",
        "warbond": {
          "id": "fixture-warbond",
          "nameZhHans": "合成债券",
          "nameEn": "Synthetic Warbond",
          "purchaseSuperCredits": 100
        },
        "page": {
          "warbondId": "fixture-warbond",
          "page": 1,
          "cumulativePrerequisiteMedals": 0
        }
      },
      "expected": {
        "runtimeHasWarbondName": true,
        "pageHasNoPurchaseSuperCredits": true,
        "asOfRequired": true
      }
    },
    {
      "caseId": "cqc72-cqc73-and-gp20-gp31-identity",
      "inputs": {
        "cqc72": { "id": "fixture-cqc72", "model": "CQC-72", "offer": "poi" },
        "cqc73": {
          "id": "fixture-cqc73",
          "model": "CQC-73",
          "offer": "warbond"
        },
        "gp20": { "id": "fixture-gp20", "model": "GP-20", "alias": "最后通牒" },
        "gp31": { "id": "fixture-gp31", "model": "GP-31", "alias": "榴弹手枪" }
      },
      "expected": { "merged": false, "aliasTargetsAreDistinct": true }
    },
    {
      "caseId": "helmet-body-order-independent",
      "inputs": {
        "rowsA": [
          { "type": "Helmet", "cost": 30 },
          { "type": "Body Armor", "cost": 45 }
        ],
        "rowsB": [
          { "type": "Body Armor", "cost": 45 },
          { "type": "Helmet", "cost": 30 }
        ]
      },
      "expected": {
        "selectedBodyCostA": 45,
        "selectedBodyCostB": 45,
        "helmetExcluded": true
      }
    },
    {
      "caseId": "p33-open-type",
      "inputs": {
        "type": "Special Secondary",
        "productKind": "secondary-weapon"
      },
      "expected": { "included": true }
    },
    {
      "caseId": "component-ap-and-demolition-range",
      "inputs": {
        "components": [
          {
            "id": "fixture-direct",
            "role": "direct",
            "armorPenetration": { "kind": "scalar", "value": 0 }
          },
          {
            "id": "fixture-explosion",
            "role": "explosion",
            "armorPenetration": { "kind": "scalar", "value": 10 },
            "demolition": { "kind": "range", "min": 30, "max": 40 }
          }
        ]
      },
      "expected": {
        "rootArmorPenetration": null,
        "componentsIndependent": true
      }
    },
    {
      "caseId": "field-evidence-states",
      "inputs": {
        "known": {
          "status": "known",
          "factIds": ["fixture-fact-1"],
          "resolvedValueHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "unknown": { "status": "unknown", "reason": "unknown-threshold" },
        "conflict": {
          "status": "conflict",
          "reason": "source-disagreement",
          "candidateFactIdGroups": [["fixture-fact-2"], ["fixture-fact-3"]]
        },
        "notApplicable": { "status": "not-applicable", "reason": "armor-only" }
      },
      "expected": {
        "knownNeedsFact": true,
        "unknownIsNotZero": true,
        "conflictNeedsTwoGroups": true
      }
    },
    {
      "caseId": "unknown-is-not-zero",
      "inputs": {
        "page": {
          "cumulativePrerequisiteMedals": null,
          "evidenceState": "unknown",
          "reason": "unknown-threshold"
        }
      },
      "expected": { "numericValue": null, "state": "unknown" }
    },
    {
      "caseId": "edition-package-is-not-item-price",
      "inputs": {
        "acquisition": {
          "kind": "edition",
          "editionName": "Synthetic Edition"
        },
        "packagePrice": { "currency": "usd", "amount": 20 }
      },
      "expected": { "itemPrice": null, "packagePriceNotEquipmentPrice": true }
    },
    {
      "caseId": "event-poi-unavailable",
      "inputs": {
        "event": { "kind": "event", "eventName": "Synthetic Event" },
        "poi": { "kind": "poi", "location": "Synthetic POI" },
        "unavailable": {
          "kind": "unavailable",
          "reason": "Synthetic unavailable"
        }
      },
      "expected": { "zeroPriceNotInjected": true }
    },
    {
      "caseId": "zh-hans-hant-conflict",
      "inputs": {
        "zhHans": "简体候选",
        "zhHant": "繁體候選",
        "sameLocaleCandidates": ["简体甲", "简体乙"]
      },
      "expected": { "hantDoesNotSupportHans": true, "state": "conflict" }
    },
    {
      "caseId": "blocked-image-uses-placeholder",
      "inputs": {
        "real": { "licenseEligible": true, "displayEligibility": "real" },
        "blocked": {
          "licenseEligible": false,
          "displayEligibility": "blocked"
        },
        "placeholder": {
          "licenseEligible": false,
          "displayEligibility": "placeholder"
        }
      },
      "expected": {
        "blockedNotProjected": true,
        "runtimeStatus": "placeholder"
      }
    },
    {
      "caseId": "stable-id-and-top-level-alias-registries",
      "inputs": {
        "id": "fixture-stable-id",
        "idAliases": [
          { "legacyId": "fixture-old-id", "equipmentId": "fixture-stable-id" }
        ],
        "aliases": [
          {
            "aliasId": "fixture-alias",
            "targetIds": ["fixture-stable-id"],
            "state": "accepted"
          }
        ]
      },
      "expected": {
        "idUnchanged": true,
        "idAliasPreserved": true,
        "aliasNotNestedOnEquipment": true
      }
    },
    {
      "caseId": "plan-orphan-and-disjoint-sets",
      "inputs": {
        "pendingIds": ["fixture-a"],
        "completedIds": ["fixture-b"],
        "orphans": [
          {
            "equipmentId": "fixture-removed",
            "lastKnownName": "旧名称",
            "reason": "removed"
          }
        ]
      },
      "expected": { "orphanRetained": true, "pendingCompletedDisjoint": true }
    },
    {
      "caseId": "stale-correction-blocks",
      "inputs": {
        "sourceBindings": [{ "sourceId": "fixture-source", "sha256": "old" }],
        "currentSourceHash": "new"
      },
      "expected": { "stale": true, "blocksResolution": true }
    },
    {
      "caseId": "runtime-hash-mismatch",
      "inputs": {
        "resolvedCatalogHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "runtimeHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "projectionHash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "expected": { "blocked": true }
    },
    {
      "caseId": "deterministic-full-reconcile",
      "inputs": {
        "sameRawHash": true,
        "sameCorrections": true,
        "canonicalSerialization": "sorted-keys-and-stable-id-order"
      },
      "expected": { "sameOutput": true, "onlySourceFetchMayCache": true }
    }
  ]
}
