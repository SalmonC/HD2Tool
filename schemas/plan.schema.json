{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hd2-supply-book/plan.schema.json",
  "title": "HD2 军需簿 plan export",
  "type": "object",
  "required": ["schemaVersion", "pendingIds", "completedIds", "updatedAt"],
  "properties": {
    "app": { "const": "HD2 军需簿" },
    "schemaVersion": { "const": 1 },
    "pendingIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "completedIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "exportedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
