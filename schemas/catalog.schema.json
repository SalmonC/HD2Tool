{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hd2-supply-book/catalog.schema.json",
  "title": "HD2 军需簿 catalog",
  "type": "object",
  "required": ["meta", "taxonomy", "warbonds", "items", "glossaryTerms"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "taxonomy": { "$ref": "#/$defs/taxonomy" },
    "warbonds": { "type": "array", "items": { "$ref": "#/$defs/warbond" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/equipment" } },
    "glossaryTerms": {
      "type": "array",
      "items": { "$ref": "#/$defs/glossaryTerm" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "game",
        "gameBuild",
        "dataVersion",
        "generatedAt",
        "verificationStatus",
        "unresolvedDifferences"
      ],
      "properties": {
        "game": { "const": "HELLDIVERS 2" },
        "gameBuild": { "type": "string" },
        "dataVersion": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "verificationStatus": { "enum": ["verified", "pending", "sample"] },
        "unresolvedDifferences": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "taxonomyOption": {
      "type": "object",
      "required": ["id", "labelZh", "sourceRefs", "verificationStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "labelZh": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "enum": ["verified", "pending", "sample"] }
      },
      "additionalProperties": false
    },
    "taxonomyDimension": {
      "type": "object",
      "required": [
        "id",
        "labelZh",
        "valueKind",
        "taxonomySource",
        "scaleVersion",
        "sourceRefs",
        "verificationStatus",
        "options"
      ],
      "properties": {
        "id": {
          "enum": [
            "weaponType",
            "ammoTraits",
            "armorPenetration",
            "demolitionPower"
          ]
        },
        "labelZh": { "type": "string" },
        "valueKind": { "enum": ["single", "multi", "number"] },
        "taxonomySource": { "type": "string" },
        "scaleVersion": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "enum": ["verified", "pending", "sample"] },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/taxonomyOption" }
        },
        "numberScale": {
          "type": "object",
          "required": ["min", "max", "step"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "weaponType" } } },
          "then": { "properties": { "valueKind": { "const": "single" } } }
        },
        {
          "if": { "properties": { "id": { "const": "ammoTraits" } } },
          "then": { "properties": { "valueKind": { "const": "multi" } } }
        },
        {
          "if": {
            "properties": {
              "id": { "enum": ["armorPenetration", "demolitionPower"] }
            }
          },
          "then": { "properties": { "valueKind": { "const": "number" } } }
        }
      ]
    },
    "taxonomy": {
      "type": "object",
      "required": ["version", "dimensions"],
      "properties": {
        "version": { "type": "string" },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/taxonomyDimension" }
        }
      },
      "additionalProperties": false
    },
    "warbond": {
      "type": "object",
      "required": [
        "id",
        "nameZh",
        "kind",
        "superCredits",
        "sourceRefs",
        "verificationStatus"
      ],
      "properties": {
        "id": { "type": "string" },
        "nameZh": { "type": "string" },
        "kind": { "type": "string" },
        "superCredits": { "type": ["number", "null"], "minimum": 0 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "enum": ["verified", "pending", "sample"] }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "path",
        "alt",
        "status",
        "originalPage",
        "author",
        "syncedAt",
        "fileHash",
        "sourceRefs",
        "licenseStatus"
      ],
      "properties": {
        "path": { "type": "string" },
        "alt": { "type": "string" },
        "status": { "enum": ["placeholder", "candidate", "verified"] },
        "originalPage": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "syncedAt": { "type": "string", "format": "date-time" },
        "fileHash": { "type": ["string", "null"] },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "licenseStatus": {
          "enum": ["project-created-placeholder", "pending", "documented"]
        }
      },
      "additionalProperties": false
    },
    "weaponField": {
      "type": "object",
      "required": [
        "value",
        "taxonomySource",
        "scaleVersion",
        "sourceRefs",
        "verificationStatus"
      ],
      "properties": {
        "value": {},
        "taxonomySource": { "type": "string", "minLength": 1 },
        "scaleVersion": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "enum": ["verified", "pending"] }
      },
      "additionalProperties": false
    },
    "weaponProfile": {
      "type": "object",
      "properties": {
        "weaponType": {
          "allOf": [
            { "$ref": "#/$defs/weaponField" },
            { "properties": { "value": { "type": "string" } } }
          ]
        },
        "ammoTraits": {
          "allOf": [
            { "$ref": "#/$defs/weaponField" },
            {
              "properties": {
                "value": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        "armorPenetration": {
          "allOf": [
            { "$ref": "#/$defs/weaponField" },
            { "properties": { "value": { "type": "number" } } }
          ]
        },
        "demolitionPower": {
          "allOf": [
            { "$ref": "#/$defs/weaponField" },
            {
              "properties": {
                "value": { "type": "integer", "minimum": 0, "maximum": 50 }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "glossaryTerm": {
      "type": "object",
      "required": [
        "id",
        "titleZh",
        "aliases",
        "description",
        "examples",
        "sourceRefs",
        "verificationStatus"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "titleZh": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "enum": ["verified", "pending"] }
      },
      "additionalProperties": false
    },
    "equipment": {
      "type": "object",
      "required": [
        "id",
        "model",
        "nameZh",
        "nameEn",
        "category",
        "image",
        "aliases",
        "acquisition",
        "sourceRefs",
        "verificationStatus",
        "notes",
        "search"
      ],
      "properties": {
        "id": { "type": "string" },
        "model": { "type": "string" },
        "nameZh": { "type": "string" },
        "nameEn": { "type": "string" },
        "category": {
          "enum": ["weapon", "armor", "stratagem", "grenade", "booster"]
        },
        "image": { "$ref": "#/$defs/asset" },
        "aliases": { "type": "array" },
        "acquisition": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "warbond",
                "requisition",
                "default",
                "superstore",
                "edition",
                "event",
                "unavailable",
                "other"
              ]
            }
          },
          "additionalProperties": true
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "enum": ["verified", "pending", "sample"] },
        "notes": { "type": "string" },
        "search": { "type": "object" },
        "weaponProfile": { "$ref": "#/$defs/weaponProfile" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "category": { "const": "weapon" } } },
          "then": {},
          "else": { "not": { "required": ["weaponProfile"] } }
        }
      ]
    }
  }
}
